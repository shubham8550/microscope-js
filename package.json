{
  "name": "microscope-js",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source JS/React/Next.js library for client-side rendering of PDF, Office, image, video and audio formats — no server dependencies",
  "license": "MIT",
  "author": "microscope-js contributors",
  "homepage": "https://shubham8550.github.io/microscope-js",
  "repository": {
    "type": "git",
    "url": "https://github.com/shubham8550/microscope-js.git"
  },
  "bugs": {
    "url": "https://github.com/shubham8550/microscope-js/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "pnpm build && pnpm -r run typecheck",
    "docs": "typedoc",
    "demo": "pnpm --filter @microscope-js/demo dev",
    "demo:build": "pnpm --filter @microscope-js/demo build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "clean": "pnpm -r exec rm -rf dist .turbo node_modules && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.11",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typedoc": "^0.27.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "viewer",
    "preview",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "office",
    "renderer",
    "react",
    "nextjs",
    "csr"
  ]
}
