{
  "name": "@microscope-js/renderer-audio",
  "version": "0.1.5",
  "description": "Audio renderer for microscope-js (mp3, wav, ogg, flac, aac, m4a)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@microscope-js/core": "workspace:*",
    "@microscope-js/utils": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shubham8550/microscope-js.git",
    "directory": "packages/renderer-audio"
  },
  "homepage": "https://github.com/shubham8550/microscope-js/tree/main/packages/renderer-audio#readme",
  "bugs": {
    "url": "https://github.com/shubham8550/microscope-js/issues"
  }
}
