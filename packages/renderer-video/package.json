{
  "name": "@microscope-js/renderer-video",
  "version": "0.1.5",
  "description": "Video renderer for microscope-js (mp4, webm, ogg, mov)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@microscope-js/core": "workspace:*",
    "@microscope-js/utils": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shubham8550/microscope-js.git",
    "directory": "packages/renderer-video"
  },
  "homepage": "https://github.com/shubham8550/microscope-js/tree/main/packages/renderer-video#readme",
  "bugs": {
    "url": "https://github.com/shubham8550/microscope-js/issues"
  }
}
