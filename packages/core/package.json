{
  "name": "@microscope-js/core",
  "version": "0.1.2",
  "description": "Framework-agnostic core for microscope-js: Renderer interface + registry + mount() entry point",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@microscope-js/utils": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shubham8550/microscope-js.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/shubham8550/microscope-js/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/shubham8550/microscope-js/issues"
  }
}
